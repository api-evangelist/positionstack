{
  "item": [
    {
      "id": "cd43f43b-db12-4641-a489-23e0cb9aa708",
      "name": "Forward Geocoding",
      "description": {
        "content": "Convert addresses, place names, or partial location strings into geographic coordinates.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "b9941fe9-cbc1-495c-9db5-a23fdce2d17f",
          "name": "Forward Geocode an Address",
          "request": {
            "name": "Forward Geocode an Address",
            "description": {
              "content": "Convert one or more location strings (street, city, place name, postal code)\ninto geographic coordinates and structured address data. Supply one or more\ncomma-separated queries to perform a batch request (Professional plan and above).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "forward"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "access_key",
                  "value": "<string>",
                  "description": "(Required) Your positionstack API access key."
                },
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "(Required) The address, place name, or location string to geocode. To run a batch\nrequest, pass multiple comma-separated queries (Professional plan and above).\n"
                },
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "Filter results to one or more ISO 3166 alpha-2 country codes (comma separated).\n"
                },
                {
                  "disabled": false,
                  "key": "region",
                  "value": "<string>",
                  "description": "Filter results by region or state name."
                },
                {
                  "disabled": false,
                  "key": "bbox",
                  "value": "<string>",
                  "description": "Bounding box filter as `min_lon,min_lat,max_lon,max_lat` to restrict the\ngeographic area of the search.\n"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Maximum number of results returned. Defaults to 10, maximum 80."
                },
                {
                  "disabled": false,
                  "key": "language",
                  "value": "<string>",
                  "description": "Two-letter ISO 639-1 language code for localized results."
                },
                {
                  "disabled": false,
                  "key": "fields",
                  "value": "all",
                  "description": "Comma-separated whitelist of fields to include in the response (e.g. `results.latitude,results.longitude`).\nDefaults to all fields.\n"
                },
                {
                  "disabled": false,
                  "key": "output",
                  "value": "json",
                  "description": "Response output format."
                },
                {
                  "disabled": false,
                  "key": "callback",
                  "value": "<string>",
                  "description": "JSONP callback function name (JSON output only)."
                },
                {
                  "disabled": false,
                  "key": "country_module",
                  "value": "0",
                  "description": "Set to `1` to enrich results with country-level data such as ISO codes,\ncapital, population, currency, language, flag URLs, and dial code.\n"
                },
                {
                  "disabled": false,
                  "key": "sun_module",
                  "value": "0",
                  "description": "Set to `1` to enrich results with sunrise, sunset, and solar transit times\nfor the location.\n"
                },
                {
                  "disabled": false,
                  "key": "timezone_module",
                  "value": "0",
                  "description": "Set to `1` to enrich results with timezone name, abbreviation, GMT offset,\nand DST status.\n"
                },
                {
                  "disabled": false,
                  "key": "bbox_module",
                  "value": "0",
                  "description": "Set to `1` to include the bounding box coordinates of each returned result.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
