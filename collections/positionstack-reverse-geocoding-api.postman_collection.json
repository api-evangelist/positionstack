{
  "item": [
    {
      "id": "3f01a7b1-59f1-466d-a118-cbca21d9e420",
      "name": "Reverse Geocoding",
      "description": {
        "content": "Convert latitude/longitude coordinates into a full address with locality, region, and country.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "d6013278-4514-4a0b-8350-714041d26cfa",
          "name": "Reverse Geocode Coordinates",
          "request": {
            "name": "Reverse Geocode Coordinates",
            "description": {
              "content": "Convert one or more latitude/longitude coordinate pairs into structured\naddress data. Supply one or more semicolon-separated coordinate pairs\n(or comma-separated batched queries) to perform a batch request\n(Professional plan and above).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "reverse"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "access_key",
                  "value": "<string>",
                  "description": "(Required) Your positionstack API access key."
                },
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "(Required) Latitude and longitude coordinate pair as a comma-separated string\n(\"LAT,LON\"). For batch reverse lookups, separate multiple pairs with\na semicolon (Professional plan and above).\n"
                },
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "Filter results to one or more ISO 3166 alpha-2 country codes (comma separated).\n"
                },
                {
                  "disabled": false,
                  "key": "region",
                  "value": "<string>",
                  "description": "Filter results by region or state name."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Maximum number of results returned. Defaults to 10, maximum 80."
                },
                {
                  "disabled": false,
                  "key": "language",
                  "value": "<string>",
                  "description": "Two-letter ISO 639-1 language code for localized results."
                },
                {
                  "disabled": false,
                  "key": "fields",
                  "value": "all",
                  "description": "Comma-separated whitelist of fields to include in the response (e.g. `results.latitude,results.longitude`).\nDefaults to all fields.\n"
                },
                {
                  "disabled": false,
                  "key": "output",
                  "value": "json",
                  "description": "Response output format."
                },
                {
                  "disabled": false,
                  "key": "callback",
                  "value": "<string>",
                  "description": "JSONP callback function name (JSON output only)."
                },
                {
                  "disabled": false,
                  "key": "country_module",
                  "value": "0",
                  "description": "Set to `1` to enrich results with country-level data such as ISO codes,\ncapital, population, currency, language, flag URLs, and dial code.\n"
                },
                {
                  "disabled": false,
                  "key": "sun_module",
                  "value": "0",
                  "description": "Set to `1` to enrich results with sunrise, sunset, and solar transit times\nfor the location.\n"
                },
                {
                  "disabled": false,
                  "key": "timezone_module",
                  "value": "0",
                  "description": "Set to `1` to enrich results with timezone name, abbreviation, GMT offset,\nand DST status.\n"
                },
                {
                  "disabled": false,
                  "key": "bbox_module",
                  "value": "0",
                  "description": "Set to `1` to include the bounding box coordinates of each returned result.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
